name: "yolo26n"
platform: "onnxruntime_onnx"
max_batch_size: 1


input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 300, 6 ]
  }
]

# Optimize memory allocation on your GPU
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]